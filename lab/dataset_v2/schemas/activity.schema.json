{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alertgraph.local/schemas/v2/activity.schema.json",
  "title": "AlertGraph Wazuh V2 controlled activity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "run_id", "activity_id", "class", "activity_name", "platform", "status", "result", "started_at_utc", "ended_at_utc", "controller_started_at_utc", "controller_ended_at_utc", "target_started_at_utc", "target_ended_at_utc", "target_agents", "target_hosts", "marker_id", "command_spec_sha256", "exit_code", "evidence_ids"],
  "properties": {
    "schema_version": {"const": "alertgraph-activity/2.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "activity_id": {"type": "string", "minLength": 1},
    "class": {"enum": ["attack", "benign"]},
    "attack_instance_id": {"type": ["string", "null"]},
    "benign_activity_id": {"type": ["string", "null"]},
    "activity_name": {"type": "string", "minLength": 1},
    "platform": {"enum": ["linux", "windows"]},
    "status": {"enum": ["planned", "dry-run", "completed", "failed", "skipped"]},
    "result": {"type": "object"},
    "true_activity_phase": {"type": ["string", "null"]},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "ended_at_utc": {"type": "string", "format": "date-time"},
    "controller_started_at_utc": {"type": "string", "format": "date-time"},
    "controller_ended_at_utc": {"type": "string", "format": "date-time"},
    "target_started_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "target_ended_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "target_agents": {"type": "array", "items": {"type": "string"}},
    "target_hosts": {"type": "array", "items": {"type": "string"}},
    "marker_id": {"type": "string", "pattern": "^agv2[-_:][A-Za-z0-9_-]{8,}$"},
    "command_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exit_code": {"type": "integer"},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
