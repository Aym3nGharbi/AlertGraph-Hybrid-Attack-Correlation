{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alertgraph.local/schemas/v2/event-activity-decision.schema.json",
  "title": "AlertGraph V2 event by activity decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "wazuh_alert_id", "studied_activity_id",
    "decision", "provenance_activity_id", "exclusive_identity_key",
    "evidence_ids", "proof_families", "reason_codes", "explanation",
    "ml_use", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "alertgraph-event-activity-decision/2.0"},
    "decision_id": {"type": "string", "minLength": 1},
    "wazuh_alert_id": {"type": "string", "minLength": 1},
    "studied_activity_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["member-verified", "nonmember-verified", "excluded"]},
    "provenance_activity_id": {"type": ["string", "null"]},
    "exclusive_identity_key": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "proof_families": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["execution-receipt", "controller-network", "linux-journal", "windows-sysmon", "windows-security", "wazuh-transport"]}
    },
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "explanation": {"type": "string", "minLength": 1},
    "ml_use": {"enum": ["verified-member", "verified-nonmember", "excluded"]},
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
